+  ['angry','🤬','暴怒','Enraged',1,1],['angry','😖','紧绷','Stressed',2,1],['angry','😱','震惊','Shocked',3,1],
+  ['angry','😤','气冲冲','Fuming',1,2],['angry','😠','愤怒','Angry',2,2],['angry','😬','躁动','Restless',3,2],
+  ['angry','🤮','反感','Repulsed',1,3],['angry','😟','担心','Worried',2,3],['angry','😕','不安','Uneasy',3,3],
