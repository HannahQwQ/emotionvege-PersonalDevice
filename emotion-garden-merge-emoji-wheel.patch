+  ['optimistic','😁','活力满满','Energized',4,2],['optimistic','😄','乐观','Optimistic',5,2],['optimistic','😆','兴奋','Excited',6,2],
+  ['optimistic','🙂','愉快','Pleasant',4,3],['optimistic','🤗','满怀希望','Hopeful',5,3],['optimistic','🥰','幸福','Blissful',6,3],
+  ['miserable','🤢','厌恶','Disgusted',1,4],['miserable','🙁','低落','Down',2,4],['miserable','🫥','冷淡','Apathetic',3,4],
