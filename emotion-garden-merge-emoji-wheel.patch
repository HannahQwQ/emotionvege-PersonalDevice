+// 摄像头给出 5 类之后，再按原始表情的强弱，在这一类里猜一个最贴近的 emoji
+function guessEmoji(cat,a){
+  const g=k=>a[k]||0;
+  if(cat==='angry'){
+    const f=g('fearful'),d=g('disgusted'),an=g('angry');
+    if(f>=an&&f>=d) return f>.55?'😱':'😟';
+    if(d>=an) return d>.55?'🤮':'😬';
+    if(g('sad')>.2) return '😖';
+    return an>.8?'🤬':an>.55?'😤':'😠';
+  }
+  if(cat==='optimistic'){
+    const h=g('happy'),su=g('surprised');
+    if(su>.35&&h>.35) return '🤩';
+    if(su>h) return '😲';
+    return h>.9?'😆':h>.7?'😁':h>.45?'😄':'🙂';
+  }
+  if(cat==='miserable'){const sd=g('sad');return sd>.85?'😭':sd>.6?'😢':sd>.4?'😔':'🙁'}
+  if(cat==='relaxed'){const h=g('happy');return h>.3?'😊':h>.15?'☺️':'😌'}
+  if(g('angry')>.1) return '🧐';
+  if(g('surprised')>.1) return '🤔';
+  if(g('sad')>.1) return '😮‍💨';
+  return '😐';
+}
