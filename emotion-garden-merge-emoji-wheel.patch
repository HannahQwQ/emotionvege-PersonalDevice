+  ['calm','😐','平静','Calm',0],['calm','😑','淡然','Neutral',1],['calm','😶','安静','Quiet',2],
+  ['calm','😮‍💨','松一口气','Exhale',3],['calm','🤔','沉思','Pensive',4],['calm','🧐','专注','Focused',5],
+];
+const CALM_POS = [[0,0],[0,-.92],[.875,-.284],[.54,.744],[-.54,.744],[-.875,-.284]];   // 平静簇：中心 + 一圈 5 个
+const MOOD_GAP = {x:.75, y:.78, py:.95};   // 四个象限向外让出的空隙（给中间的平静簇）与行距；单位＝一个 emoji 的直径
+const MOODS = MOOD_RAW.map(([cat,e,zh,en,c,r])=>{
+  let x,y;
+  if(cat==='calm'){[x,y]=CALM_POS[c]}
+  else{x=(c-3.5)+Math.sign(c-3.5)*MOOD_GAP.x; y=(r-3.5)*MOOD_GAP.py+Math.sign(r-3.5)*MOOD_GAP.y}
+  return {cat,e,zh,en,x,y};
+});
+const MOOD_RMAX = Math.max(...MOODS.map(m=>Math.hypot(m.x,m.y)));
+// 强度：离中心越远越强，1–7 级（平静簇只有 1–2 级）
+MOODS.forEach(m=>{m.level=Math.max(1,Math.min(7,1+Math.round(Math.hypot(m.x,m.y)/MOOD_RMAX*6)))});
